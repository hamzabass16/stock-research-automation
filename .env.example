# ---- Required for live research ----
ANTHROPIC_API_KEY=
DEMO_MODE=false            # true = click through the UI with mock output, no API calls

# ---- Storage (Neon Postgres is required; Vercel Blob is required on Vercel, optional locally) ----
DATABASE_URL=              # Neon connection string
BLOB_READ_WRITE_TOKEN=     # Vercel Blob store token (artifacts); locally the worker falls back to temp files when unset

# ---- Where the research worker runs ----
RUNNER=local               # local = detached node process (default outside Vercel); sandbox = Vercel Sandbox (default on Vercel)
RUN_BUDGET_MINUTES=36      # wall-clock budget per run (Hobby sandboxes are capped at 45 min including setup)

# ---- Research settings ----
ANTHROPIC_MODEL=claude-opus-5-5
RESEARCH_EFFORT=medium     # low | medium | high | xhigh | max  (high needs ~40 min; use medium under a 45-min budget)
PREPARED_BY=Your Name      # listed as the preparer on every report and deck, with Claude
MAX_WEB_SEARCHES=28
MAX_WEB_FETCHES=18
MAX_TURNS=40
FALLBACKS=on               # server-side refusal fallbacks (off to disable)

# ---- Publishing to Google Drive ----
# In the cloud: a service account that has Editor access to the "Stock Theses & Research" folder.
GOOGLE_SERVICE_ACCOUNT_JSON=   # the service-account key JSON (raw or base64)
DRIVE_PARENT_FOLDER_ID=        # the folder ID from the Drive URL of "Stock Theses & Research"
# Locally without the service account: the worker copies into the synced Google Drive folder instead.
# DRIVE_PUBLISH_DIR=           # override the local folder (defaults to ~/Library/CloudStorage/GoogleDrive-*/My Drive/HCMP/Stock Theses & Research)
