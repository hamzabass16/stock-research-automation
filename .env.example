# ---- Required for live research ----
ANTHROPIC_API_KEY=
DEMO_MODE=false            # true = click through the UI with mock output, no API calls

# ---- Research settings ----
ANTHROPIC_MODEL=claude-opus-5-5
RESEARCH_EFFORT=high       # low | medium | high | xhigh | max  (xhigh/max = deeper, slower, pricier)
PREPARED_BY=Your Name       # listed as the preparer on every report and deck, with Claude
MAX_WEB_SEARCHES=40
MAX_WEB_FETCHES=25
MAX_TURNS=40
FALLBACKS=on               # server-side refusal fallbacks (off to disable)

# ---- Publishing ----
# Outputs are copied into <this folder>/<Company (TICKER)>/ with the publish date in every filename.
# Defaults to the synced Google Drive folder: ~/Library/CloudStorage/GoogleDrive-<account>/My Drive/HCMP/Stock Theses & Research
# DRIVE_PUBLISH_DIR=

PORT=4317
